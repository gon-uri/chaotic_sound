{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "packages/**/*.ts",
      "apps/**/*.ts",
      "apps/**/*.tsx",
      "apps/**/*.css",
      "packages/**/*.json",
      "apps/**/*.json",
      "*.json",
      "!**/node_modules",
      "!**/dist",
      "!examples",
      "!catalog"
    ]
  },
  "formatter": {
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always"
    }
  },
  "linter": {
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useNumberNamespace": "off"
      },
      "suspicious": {
        "noAssignInExpressions": "off"
      },
      "complexity": {
        "useMathMinMax": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["**/*.css"],
      "linter": {
        "rules": {
          "complexity": {
            "noImportantStyles": "off"
          }
        }
      }
    }
  ]
}
